{
  "servers": [
    {"name": "kb", "namespace": "kb", "transport": "inproc", "target": "knowledge", "enabled": true,
     "note": "Search the indexed roadmap material."},
    {"name": "learner", "namespace": "learner", "transport": "inproc", "target": "learner", "untrusted": false,
     "enabled": true, "note": "The learner's progress and notes."},
    {"name": "ingest", "namespace": "ingest", "transport": "inproc", "target": "ingestion", "untrusted": false,
     "enabled": true, "note": "Roadmap ingestion tools."},
    {"name": "web", "namespace": "web", "transport": "inproc", "target": "web", "enabled": true,
     "note": "Web search and page fetch."}
  ],
  "agents": {
    "teacher": ["kb.*", "web.search", "web.fetch", "browser.navigate", "browser.snapshot", "browser.navigate_back",
                "docs.*", "repo.*", "papers.*", "ref.*", "learner.recall", "learner.get_progress"],
    "researcher": ["kb.search", "web.search", "web.fetch", "browser.navigate", "browser.snapshot", "docs.*",
                   "repo.*", "papers.*", "ref.*"],
    "crawler": ["browser.navigate", "browser.evaluate", "browser.close"]
  }
}

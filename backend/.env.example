# Qdrant Cloud (leave both empty to use embedded local mode in backend/qdrant_local/)
QDRANT_URL=
QDRANT_API_KEY=

# Gemini: public tier + YouTube video understanding
GEMINI_API_KEY=

# Claude Haiku 5.5 on Microsoft Foundry: premium tier, eval judge
TESTFORGE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic/
TESTFORGE_FOUNDRY_API_KEY=
FOUNDRY_HAIKU_DEPLOYMENT=claude-haiku-5-5

# Unlocks the Claude tier and the /mcp endpoint (leave empty to disable both)
PREMIUM_PASSCODE=

# Re-runs of the legacy scraper (backend/ingest.py) and GitHub API rate limits in the platform.
# In the platform it also enables the GitHub MCP server (repo.github, read-only tool set).
GITHUB_TOKEN=

# Roadmap tutor platform (all optional; the defaults are shown). See docs/platform/running-locally.md.
# SEARXNG_URL=http://127.0.0.1:8888       (compose points the API at its own searxng service)
# YOUTUBE_API_KEY=                        free; better video metadata, playlist expansion, comment timestamps
# TRANSCRIPT_ROUTES=captions              comma list of captions, ytdlp_cookies, gemini (the last two are opt-in)
# YTDLP_COOKIES_BROWSER=                  e.g. chrome; required when TRANSCRIPT_ROUTES has ytdlp_cookies
# INGEST_WORKERS=2                        0 starts no workers in the API
# CRAWL_MAX_DEPTH=2
# CRAWL_MAX_PAGES=50
# DOMAIN_INTERVAL_S=1.0                   minimum seconds between requests to one host
# PLAYLIST_MAX_VIDEOS=50
# EMBEDDER=bge                            bge or hash (hash is for tests)
# INGEST_AGENT=true                       the Haiku ingestion agent

# MCP servers (backend/tutor/mcp/servers.json). Check them with: python -m backend.tutor mcp-check
# PLAYWRIGHT_MCP_URL=http://127.0.0.1:8931/mcp   the playwright-mcp compose service (compose sets its own URL)
# CONTEXT7_API_KEY=                              enables the Context7 docs server (docs.context7)
# ARXIV_STORAGE_PATH=/tmp/roadmap-tutor/arxiv    where the arXiv server keeps downloaded papers

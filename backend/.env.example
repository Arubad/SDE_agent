# Qdrant Cloud (leave both empty to use embedded local mode in backend/qdrant_local/)
QDRANT_URL=
QDRANT_API_KEY=

# Gemini: public tier + YouTube video understanding
GEMINI_API_KEY=

# Claude Haiku 5.5 on Microsoft Foundry: premium tier, eval judge
TESTFORGE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com/anthropic/
TESTFORGE_FOUNDRY_API_KEY=
FOUNDRY_HAIKU_DEPLOYMENT=claude-haiku-5-5

# Unlocks the Claude tier and the /mcp endpoint (leave empty to disable both)
PREMIUM_PASSCODE=

# Only needed to re-run the legacy scraper (backend/ingest.py)
GITHUB_TOKEN=
